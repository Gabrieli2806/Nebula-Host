      "group": "players"
    }
  ],
  "logs": {
    "latest": "logs/latest.log",
    "crash_dir": "crash-reports"
  },
  "server_icon": {
    "file": "server-icon.png",
    "size": 64
  },
  "backup": {
    "include": [
      "world",
      "world_nether",
      "world_the_end",
      "server.properties",
      "ops.json",
      "whitelist.json",
      "banned-players.json",
      "banned-ips.json",
      "mods",
      "plugins",
      "config"
    ],
    "exclude": [
      "**/logs/**",
      "**/crash-reports/**",
      "**/cache/**",
      "**/*.log.gz"
    ],
    "requires_stop": false,
    "flush_command": "save-all flush"
  },
  "wake": {
    "protocol": "minecraft_java",
    "sleeping_motd": "{name} is asleep — join to wake it",
    "bind_setting": "server-ip"
  }
}
