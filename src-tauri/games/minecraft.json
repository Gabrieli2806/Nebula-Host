  "players": {
    "kind": "files",
    "lists": {
      "allowed": "whitelist.json",
      "operators": "ops.json",
      "banned": "banned-players.json"
    },
    "identity_file": "usercache.json"
  },
  "settings": [
    {
      "key": "motd",
      "label_key": "setting.minecraft.motd",
      "help_key": "setting.minecraft.motd.help",
      "type": "text",
      "default": "A Nebula Host Server",
      "max_len": 59,
      "group": "identity"
    },
    {
      "key": "max-players",
      "label_key": "setting.minecraft.max_players",
      "type": "int",
      "default": 20,
      "min": 1,
      "max": 200,
      "group": "players"
    },
    {
      "key": "white-list",
      "label_key": "setting.minecraft.whitelist",
      "help_key": "setting.minecraft.whitelist.help",
      "type": "bool",
      "default": false,
      "group": "players"
    },
    {
      "key": "online-mode",
      "label_key": "setting.minecraft.online_mode",
      "help_key": "setting.minecraft.online_mode.help",
      "type": "bool",
      "default": true,
      "group": "players",
      "restart_required": true
    },
    {
      "key": "pvp",
      "label_key": "setting.minecraft.pvp",
      "type": "bool",
      "default": true,
      "group": "world"
    },
    {
      "key": "difficulty",
      "label_key": "setting.minecraft.difficulty",
      "type": "choice",
      "default": "easy",
      "options": [
        {
          "value": "peaceful",
          "label_key": "setting.minecraft.difficulty.peaceful"
        },
        {
          "value": "easy",
          "label_key": "setting.minecraft.difficulty.easy"
        },
        {
          "value": "normal",
          "label_key": "setting.minecraft.difficulty.normal"
        },
        {
          "value": "hard",
          "label_key": "setting.minecraft.difficulty.hard"
        }
      ],
      "group": "world"
    },
    {
      "key": "gamemode",
      "label_key": "setting.minecraft.gamemode",
      "type": "choice",
      "default": "survival",
      "options": [
        {
          "value": "survival",
          "label_key": "setting.minecraft.gamemode.survival"
        },
        {
          "value": "creative",
          "label_key": "setting.minecraft.gamemode.creative"
        },
        {
          "value": "adventure",
          "label_key": "setting.minecraft.gamemode.adventure"
        },
