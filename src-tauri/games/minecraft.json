{
  "id": "minecraft",
  "name": "Minecraft: Java Edition",
  "accent": "#5FBF8F",
  "icon": "minecraft",
  "agreement": {
    "url": "https://aka.ms/MinecraftEULA"
  },
  "distributions": [
    {
      "id": "vanilla",
      "accent": "#79b851",
      "name": "Vanilla",
      "summary_key": "game.minecraft.dist.vanilla",
      "glyph": "cube",
      "has_loader_version": false
    },
    {
      "id": "paper",
      "accent": "#dfe6ee",
      "name": "Paper",
      "summary_key": "game.minecraft.dist.paper",
      "glyph": "sheet",
      "has_loader_version": false,
      "addon_loaders": [
        "paper",
        "spigot",
        "bukkit"
      ],
      "addon_dir": "plugins",
      "tick_rate_command": "tps",
      "addon_project_type": "plugin"
    },
    {
      "id": "purpur",
      "accent": "#a855f7",
      "name": "Purpur",
      "summary_key": "game.minecraft.dist.purpur",
      "glyph": "pillar",
      "has_loader_version": false,
      "addon_loaders": [
        "purpur",
        "paper",
        "spigot",
        "bukkit"
      ],
      "addon_dir": "plugins",
      "tick_rate_command": "tps",
      "addon_project_type": "plugin"
    },
    {
      "id": "fabric",
      "accent": "#c8a165",
      "name": "Fabric",
      "summary_key": "game.minecraft.dist.fabric",
      "glyph": "spool",
      "has_loader_version": true,
      "addon_loaders": [
        "fabric"
      ],
      "addon_dir": "mods",
      "addon_project_type": "mod"
    },
    {
      "id": "forge",
      "accent": "#5b7fa6",
      "name": "Forge",
      "summary_key": "game.minecraft.dist.forge",
      "glyph": "hammer",
      "has_loader_version": true,
      "addon_loaders": [
        "forge"
      ],
      "addon_dir": "mods",
      "tick_rate_command": "forge tps",
      "addon_project_type": "mod"
    },
    {
      "id": "neoforge",
      "accent": "#f16436",
      "name": "NeoForge",
      "summary_key": "game.minecraft.dist.neoforge",
      "glyph": "flame",
      "has_loader_version": true,
      "addon_loaders": [
        "neoforge"
      ],
      "addon_dir": "mods",
      "tick_rate_command": "neoforge tps",
      "addon_project_type": "mod"
    }
  ],
  "runtime": {
    "kind": "java",
    "min_major": 8
  },
  "ports": [
    {
      "key": "server-port",
      "default": 25565,
      "protocol": "tcp",
      "primary": true
    }
  ],
  "console": {
    "ready_pattern": "Done \\([^)]*\\)!",
    "join_pattern": "(?P<name>[A-Za-z0-9_]{1,16}) joined the game",
    "leave_pattern": "(?P<name>[A-Za-z0-9_]{1,16}) left the game",
    "tick_rate_patterns": [
      "TPS from last 1m, 5m, 15m: \\*?(?P<value>\\d+(?:\\.\\d+)?)",
      "Overall:\\s+(?P<value>\\d+(?:\\.\\d+)?) TPS",
      "Mean TPS:\\s*(?P<value>\\d+(?:\\.\\d+)?)"
    ],
    "suppress_patterns": [
      "TPS from last 1m",
      "[A-Za-z][A-Za-z ]*: \\d+(?:\\.\\d+)? TPS \\(",
      "Mean tick time:"
    ],
    "stop_command": "stop",
    "stopping_pattern": "(?:^|\\]: |\\[[A-Za-z0-9_]{1,16}: )Stopping (?:the )?server\\]?$",
    "crash_pattern": "Encountered an unexpected exception|This crash report has been saved to|Considering it to be crashed|Failed to start the minecraft server|The server has stopped responding!",
    "strip_colour_codes": true,
    "chat_pattern": "\\]: (?:\\[Not Secure\\] )?<(?P<name>[A-Za-z0-9_]{1,16})> (?P<message>.*)$",
    "log_prefix_pattern": "^\\[\\d{2}:\\d{2}:\\d{2}(?: [A-Z]+)?\\]:? (?:\\[[^\\]]*/[A-Z]+\\](?: \\[[^\\]]+\\])?: )?",
    "identity_pattern": "UUID of player (?P<name>[A-Za-z0-9_]{1,16}) is (?P<uuid>[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12})",
    "completion": {
      "help_command": "help",
      "page_command": "help {page}",
      "page_pattern": "Help: Index \\((?P<page>\\d+)/(?P<pages>\\d+)\\)",
      "entry_pattern": "(?:^|\\]: )/(?P<command>/?[A-Za-z0-9_.\\-]+(?::[A-Za-z0-9_.\\-]+)?)(?:: (?P<description>.+)| (?P<usage>.+))?$",
      "noise_patterns": [
        "\\]: Use /help \\[n\\] to get page n of help",
        "\\]: [A-Za-z0-9 _.\\-]+: All commands for ",
        "\\]: Aliases: Lists command aliases",
        "\\]: -{3,}"
      ],
      "max_pages": 20,
      "player_placeholders": [
        "<targets>",
        "<target>",
        "<player>",
        "<players>"
      ],
      "builtin": [
        {
          "name": "advancement",
          "usage": "(grant|revoke) <targets> (everything|only|from|through|until) [<advancement>]"
        },
        {
          "name": "attribute",
          "usage": "<target> <attribute> (get|base|modifier) ..."
        },
        {
          "name": "ban",
          "usage": "<targets> [<reason>]"
        },
        {
          "name": "ban-ip",
          "usage": "<target> [<reason>]"
        },
        {
          "name": "banlist",
          "usage": "[ips|players]"
        },
        {
          "name": "bossbar",
          "usage": "(add|get|list|remove|set) ..."
        },
        {
          "name": "clear",
          "usage": "[<targets>] [<item>] [<maxCount>]"
        },
        {
          "name": "clone",
          "usage": "<begin> <end> <destination> [replace|masked|filtered]"
        },
        {
          "name": "damage",
          "usage": "<target> <amount> [<damageType>]"
        },
        {
          "name": "data",
          "usage": "(get|merge|modify|remove) (block|entity|storage) ..."
        },
        {
