      "type": "bool",
      "default": false,
      "group": "world",
      "restart_required": true
    },
    {
      "key": "level-seed",
      "label_key": "setting.minecraft.seed",
      "help_key": "setting.minecraft.seed.help",
      "type": "text",
      "default": "",
      "group": "world",
      "restart_required": true
    },
    {
      "key": "view-distance",
      "label_key": "setting.minecraft.view_distance",
      "help_key": "setting.minecraft.view_distance.help",
      "type": "int",
      "default": 10,
      "min": 3,
      "max": 32,
      "unit": "chunks",
      "group": "performance"
