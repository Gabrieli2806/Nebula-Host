<?xml version="1.0" encoding="utf-8"?>
<!-- The Nebula Host orbit mark (src/ui/Mark.tsx), drawn as a vector so the
     adaptive launcher icon stays sharp at any size and mask shape. The mark
     sits in the 66dp safe zone of the 108dp canvas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:translateX="24" android:translateY="24" android:scaleX="2.5" android:scaleY="2.5">
        <group android:pivotX="12" android:pivotY="12" android:rotation="14">
            <path
                android:pathData="M5.2,12 a6.8,10 0 1,0 13.6,0 a6.8,10 0 1,0 -13.6,0"
                android:strokeColor="#1D6E86"
                android:strokeWidth="1.3"
                android:fillColor="#00000000" />
        </group>
        <group android:pivotX="12" android:pivotY="12" android:rotation="-22">
            <path
                android:pathData="M1.6,12 a10.4,4.6 0 1,0 20.8,0 a10.4,4.6 0 1,0 -20.8,0"
                android:strokeColor="#2AB6D3"
                android:strokeWidth="1.3"
                android:fillColor="#00000000" />
        </group>
        <path
            android:pathData="M9,12 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0"
            android:fillColor="#22D3EE" />
    </group>
</vector>
