<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <application android:allowNativeHeapPointerTagging="false">
        <activity android:name="net.kdt.pojavlaunch.NebulaBootstrapActivity" android:exported="false"
            android:process=":game" android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation|uiMode"
            android:theme="@style/AppTheme" />
        <activity android:name="net.kdt.pojavlaunch.NebulaGameActivity" android:exported="false"
            android:process=":game" android:screenOrientation="sensorLandscape"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation|uiMode"
            android:theme="@style/AppTheme" />
        <activity android:name="net.kdt.pojavlaunch.CustomControlsActivity" android:exported="false" android:process=":game" android:screenOrientation="sensorLandscape" android:theme="@style/AppTheme" />
        <activity android:name="net.kdt.pojavlaunch.FatalErrorActivity" android:exported="false" android:process=":game" android:theme="@style/AppTheme" />
        <activity android:name="net.kdt.pojavlaunch.ShowErrorActivity" android:exported="false" android:process=":game" android:theme="@style/AppTheme" />
        <activity android:name="net.kdt.pojavlaunch.ExitActivity" android:exported="false" android:process=":game" android:theme="@style/AppTheme" />
        <service android:name="net.kdt.pojavlaunch.services.GameService" android:exported="false" android:process=":game" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Runs the Minecraft client while its game activity is temporarily in the background." />
        </service>
    </application>
</manifest>
